# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables instead.
#
# Every demo on this site degrades gracefully without these set (the Ops
# Automation dashboard falls back to generated history, the contact form
# reports that it isn't wired up yet), so the app still runs without them.

# Supabase project URL, from Project Settings -> API.
SUPABASE_URL=

# Supabase anon/publishable key, from Project Settings -> API. This is
# intentionally the anon key, not the service role secret: every table it
# touches has its own narrow RLS policy (see supabase/migrations/), so the
# app never needs a bypass-everything credential.
SUPABASE_ANON_KEY=
